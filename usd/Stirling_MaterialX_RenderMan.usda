    prepend apiSchemas = ["PxrAttributesAPI", "PxrPrimvarsAPI"]
    prepend references = @../geo/Stirling.usda@
)
{
    float primvars:karma:object:dicingquality = 1 (
        interpolation = "constant"
    )
